# GEMINI_API_KEY: Required by LangChain's Google Generative AI chat model.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AUTH_HASH_SALT="GENERATE_A_RANDOM_32_BYTE_SECRET"
DATABASE_PATH="./data/aegisdid.db"
REDIS_URL="redis://localhost:6379"
MST_NETWORK="testnet"
MST_RPC_URL="https://testnetrpc.mstblockchain.com"
MST_PRIVATE_KEY="0xYOUR_64_HEX_CHARACTER_SERVER_WALLET_KEY"
MST_CREDENTIAL_REGISTRY_ADDRESS="0x8ea34e36670557A552c25F37A81b895Ca0535F6c"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="GENERATE_A_RANDOM_10_PLUS_CHARACTER_SECRET"
AEGIS_TRUSTED_ISSUERS_JSON="{}"

# Public client configuration. These are safe to expose in the browser bundle.
VITE_MST_CHAIN_ID="0x5752035"
VITE_MST_NETWORK_NAME="MST Testnet"
VITE_MST_RPC_URL="https://testnetrpc.mstblockchain.com"
VITE_MST_EXPLORER_URL="https://testnet.mstscan.com"
VITE_MST_CREDENTIAL_REGISTRY_ADDRESS="0x8ea34e36670557A552c25F37A81b895Ca0535F6c"
VITE_MST_MIN_NATIVE_BALANCE="0.001"
VITE_MST_FAUCET_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
